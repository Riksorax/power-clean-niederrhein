@inject IEmailService EmailService

<section id="kontakt" class="section-padding bg-off-white">
    <div class="container">
        <div class="row g-4">
            <!-- Linke Spalte: Kontaktformular -->
            <div class="col-lg-7">
                <div class="contact-form-section">
                    <h2 class="fs-2 fw-semibold text-moss-green mb-4">Schreiben Sie uns</h2>
                    <EditForm Model="@_contactFormModel" OnValidSubmit="@HandleValidSubmit" FormName="contactForm">
                        <DataAnnotationsValidator />
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label for="name" class="form-label text-light-gray">Name *</label>
                                <InputText id="name" class="form-control" @bind-Value="_contactFormModel.Name" />
                                <ValidationMessage For="@(() => _contactFormModel.Name)" class="text-danger"/>
                            </div>
                            <div class="col-sm-6">
                                <label for="email" class="form-label text-light-gray">E-Mail *</label>
                                <InputText id="email" type="email" class="form-control" @bind-Value="_contactFormModel.Email" />
                                <ValidationMessage For="@(() => _contactFormModel.Email)" class="text-danger"/>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label text-light-gray">Telefon</label>
                            <InputText id="phone" class="form-control" @bind-Value="_contactFormModel.Phone" />
                        </div>
                        <div class="mb-3">
                            <label for="service" class="form-label text-light-gray">Gewünschte Leistung *</label>
                            <InputSelect id="service" class="form-select" @bind-Value="_contactFormModel.Service">
                                <option value="">Bitte auswählen</option>
                                <option value="terrassenreinigung">Terrassenreinigung</option>
                                <option value="gehwegreinigung">Gehwegreinigung</option>
                                <option value="balkonreinigung">Balkonreinigung</option>
                                <option value="auffahrtreinigung">Auffahrtreinigung</option>
                                <option value="parkplatzreinigung">Parkplatzreinigung</option>
                                <option value="winterdienst">Winterdienst</option>
                                <option value="sonstiges">Sonstiges / Individuelle Anfrage</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => _contactFormModel.Service)" class="text-danger"/>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label text-light-gray">Ihre Nachricht *</label>
                            <InputTextArea id="message" class="form-control" @bind-Value="_contactFormModel.Message" rows="5" />
                            <ValidationMessage For="@(() => _contactFormModel.Message)" class="text-danger"/>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox id="privacy" class="form-check-input border-moss-green" @bind-Value="_contactFormModel.AcceptPrivacy" />
                            <label class="form-check-label text-light-gray" for="privacy">Ich habe die <a href="datenschutz" class="text-moss-green">Datenschutzerklärung</a> gelesen und akzeptiere diese. *</label>
                             <ValidationMessage For="@(() => _contactFormModel.AcceptPrivacy)" class="text-danger"/>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-moss-green cta-button w-100 btn-lg" disabled="@(_isSubmitting || !_contactFormModel.AcceptPrivacy)">
                                @if (_isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span class="visually-hidden">Senden...</span>
                                }
                                else
                                {
                                    <span>Nachricht senden</span>
                                }
                            </button>
                        </div>
                        @if (_submitMessage != null)
                        {
                            <div class="mt-3 alert @(_submitSuccess ? "alert-success" : "alert-danger")">@_submitMessage</div>
                        }
                    </EditForm>
                </div>
            </div>
            <!-- Rechte Spalte: Kontaktdaten & Servicegebiet -->
            <div class="col-lg-5">
                 <div class="contact-details-section mb-4">
                    <h3 class="fs-5 fw-semibold mb-3">Kontaktdaten</h3>
                    <div class="d-flex align-items-start mb-2">
                        <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" /></svg>
                        <div>
                            <span class="fw-semibold">Adresse:</span><br>
                            Roth & Speulmans Power Clean Niederrhein GbR<br>
                            Thielenstr.3<br>
                            47574 Goch
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <svg class="contact-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" /><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" /></svg>
                        <div>
                            <span class="fw-semibold">E-Mail:</span><br>
                            <a href="mailto:info@powerclean-niederrhein.de">info@powercleanniederrhein.de</a>
                        </div>
                    </div>
                </div>

                <div class="service-area-section">
                    <h3 class="fs-5 fw-semibold text-moss-green mb-3">Unser Servicegebiet</h3>
                    <p class="text-dark-gray mb-2">Wir sind in der gesamten Region Niederrhein für Sie im Einsatz:</p>
                    <ul class="list-unstyled">
                        <li class="d-flex align-items-center text-dark-gray mb-1">
                            <svg class="service-area-icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                            Goch
                        </li>
                        <li class="d-flex align-items-center text-dark-gray mb-1">
                            <svg class="service-area-icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                            Weeze
                        </li>
                        <li class="d-flex align-items-center text-dark-gray mb-1">
                            <svg class="service-area-icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                            Kevelaer
                        </li>
                        <li class="d-flex align-items-center text-dark-gray">
                            <svg class="service-area-icon me-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                            Uedem
                        </li>
                    </ul>
                    <p class="text-dark-gray mt-2 small">Weitere Orte auf Anfrage.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private ContactFormModel _contactFormModel = new();
    private bool _isSubmitting;
    private string? _submitMessage;
    private bool _submitSuccess;
    
    private async Task HandleValidSubmit()
    {
        try
        {
            _isSubmitting = true;
            await EmailService.SendEmailAsync(_contactFormModel);
            _isSubmitting = false;
            _submitMessage = "Vielen Dank für Ihre Nachricht! Wir melden uns in Kürze.";
            _contactFormModel = new ContactFormModel(); // Formular zurücksetzen
            _submitSuccess = true;
        }
        catch (Exception ex)
        {
            _isSubmitting = false;
            _submitMessage = $"Fehler beim Senden der E-Mail: {ex.Message}";
            _submitSuccess = false;
            // Hier könnten Sie auch eine Log-Nachricht hinzufügen
            Console.WriteLine($"E-Mail-Fehler: {ex.Message}");
        }
        
        StateHasChanged();
        await Task.Delay(5000);
        if (_submitMessage.StartsWith("Vielen Dank")) // Nur ausblenden, wenn es die ursprüngliche Nachricht ist
        {
            _submitSuccess = true;
            _isSubmitting = false;
            StateHasChanged();
        }
        else if (_submitMessage.StartsWith("Fehler"))
        {
            _submitSuccess = false;
            _isSubmitting = false;
            StateHasChanged();
        }

    }
}